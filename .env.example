# SMC Trading Bot — Environment Configuration
# Copy this file to .env and fill in your credentials

# ── Bitunix API (required for live trading) ──────────────────────────────────
# Get your API key from: https://www.bitunix.com/user-center/api
BITUNIX_API_KEY=YOUR_BITUNIX_API_KEY_HERE
BITUNIX_SECRET_KEY=YOUR_BITUNIX_SECRET_KEY_HERE

# Optional: override Bitunix base URL (default: https://fapi.bitunix.com)
# BITUNIX_BASE_URL=https://fapi.bitunix.com

# ── Discord Notifications (optional) ─────────────────────────────────────────
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE

# ── Broker Mode (default: off = paper/sim only) ───────────────────────────────
# Set to 'bitunix_futures' to enable live Bitunix trading
# BROKER_EXEC=bitunix_futures
